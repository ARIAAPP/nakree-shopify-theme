<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#047857">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.meta_domain_verification != blank -%}
      <meta name="facebook-domain-verification" content="{{ settings.meta_domain_verification }}">
    {%- endif -%}

    {%- comment -%}
      Favicon. Il etait conditionne a settings.logo, qui est vide : le site
      n'avait donc aucune icone d'onglet, juste la page blanche du navigateur.
      On le pose en dur. Le monogramme est celui de l'en-tete, « n. » blanc
      sur le vert de la marque.
    {%- endcomment -%}
    <link rel="icon" type="image/png" sizes="32x32" href="{{ 'nakree-favicon-32.png' | asset_url }}">
    <link rel="icon" type="image/png" sizes="512x512" href="{{ 'nakree-favicon-512.png' | asset_url }}">
    <link rel="apple-touch-icon" href="{{ 'nakree-favicon-180.png' | asset_url }}">

    {%- comment -%}
      Referencement. Aucune promesse commerciale ici : ni « satisfait ou
      rembourse », ni garantie commerciale, ni gratuite de retour. Les protections sont dans
      les politiques, jamais en facade.
    {%- endcomment -%}
    <title>
      {%- if request.page_type == 'index' -%}
        Nakree — Masseur nuque et épaules sans fil, chauffant
      {%- elsif request.page_type == 'product' -%}
        {{ product.title }} | Nakree
      {%- elsif request.page_type == 'cart' -%}
        Panier | Nakree
      {%- else -%}
        {{ page_title }} | Nakree
      {%- endif -%}
    </title>

    {%- assign desc_defaut = "Le masseur nuque et épaules Nakree : trois modes de massage, deux niveaux de chaleur, arrêt automatique à dix minutes. Sans fil, charge USB-C. Livraison offerte." -%}
    <meta name="description" content="{% if page_description %}{{ page_description | escape }}{% else %}{{ desc_defaut }}{% endif %}">

    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Nakree">
    <meta property="og:locale" content="fr_FR">
    <meta property="og:title" content="{{ page_title | default: 'Nakree — Masseur nuque et épaules sans fil, chauffant' | escape }}">
    <meta property="og:description" content="{% if page_description %}{{ page_description | escape }}{% else %}{{ desc_defaut }}{% endif %}">
    <meta property="og:url" content="{{ canonical_url }}">
    {%- if request.page_type == 'product' and product.featured_image -%}
      <meta property="og:image" content="https:{{ product.featured_image | image_url: width: 1200 }}">
    {%- endif -%}
    <meta name="twitter:card" content="summary_large_image">

    {%- comment -%} Donnees structurees. La note et le nombre d'avis viennent
      du produit reel : on ne les ecrit pas en dur. {%- endcomment -%}
    {%- if request.page_type == 'product' -%}
      <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Product",
        "name": {{ product.title | json }},
        "description": {{ product.description | strip_html | truncate: 300 | json }},
        "image": ["https:{{ product.featured_image | image_url: width: 1200 }}"],
        "brand": { "@type": "Brand", "name": "Nakree" },
        "sku": {{ product.selected_or_first_available_variant.sku | json }},
        "offers": {
          "@type": "AggregateOffer",
          "priceCurrency": {{ cart.currency.iso_code | json }},
          "lowPrice": "{{ product.price_min | money_without_currency | strip }}",
          "highPrice": "{{ product.price_max | money_without_currency | strip }}",
          "offerCount": {{ product.variants.size }},
          "availability": "https://schema.org/{% if product.available %}InStock{% else %}OutOfStock{% endif %}",
          "url": "{{ shop.url }}{{ product.url }}"
        }
      }
      </script>
    {%- endif -%}

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Nakree",
      "url": "{{ shop.url }}",
      "email": "support@nakree.com"
    }
    </script>

    {%- comment -%} Polices : Geist, chargee sans bloquer le rendu {%- endcomment -%}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" media="print" onload="this.media='all'"
          href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap">
    <noscript><link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap"></noscript>

    {{ 'nakree-da.css' | asset_url | stylesheet_tag }}

    {%- comment -%} Pixel Meta {%- endcomment -%}
    {%- assign pixel = settings.meta_pixel_id | default: '1000416475805967' -%}
    {%- if pixel != blank -%}
      <script>
        !function(f,b,e,v,n,t,s)
        {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
        n.callMethod.apply(n,arguments):n.queue.push(arguments)};
        if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
        n.queue=[];t=b.createElement(e);t.async=!0;
        t.src=v;s=b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t,s)}(window, document,'script',
        'https://connect.facebook.net/en_US/fbevents.js');
        fbq('init', '{{ pixel }}');
        fbq('track', 'PageView');
      </script>
      <noscript><img height="1" width="1" style="display:none"
        src="https://www.facebook.com/tr?id={{ pixel }}&ev=PageView&noscript=1" alt=""></noscript>
    {%- endif -%}

    {{ content_for_header }}
  </head>

  <body class="template-{{ request.page_type }}">
    {% section 'nk-entete' %}

    <main id="contenu" role="main">
      {{ content_for_layout }}
    </main>

    {% section 'nk-pied' %}

    {{ 'nakree.js' | asset_url | script_tag }}
  </body>
</html>
