<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#FFFFFF">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- comment -%}
      Langues. Le francais vit a la racine, l'anglais sous /en (reglage
      Marches / langue par defaut du domaine). hreflang dit aux moteurs
      quelle version servir ; le petit script aiguille le visiteur dont le
      navigateur n'est pas en francais vers /en, une seule fois, et son
      choix manuel (bouton FR/EN de l'entete) est memorise et respecte.
    {%- endcomment -%}
    {%- assign nk_chemin = request.path | remove_first: '/en/' | prepend: '/' | replace: '//', '/' -%}
    {%- if request.path == '/en' -%}{%- assign nk_chemin = '/' -%}{%- endif -%}
    <link rel="alternate" hreflang="fr" href="{{ shop.url }}{{ nk_chemin }}">
    <link rel="alternate" hreflang="en" href="{{ shop.url }}/en{{ nk_chemin | replace: '//', '/' }}">
    <link rel="alternate" hreflang="x-default" href="{{ shop.url }}{{ nk_chemin }}">
    {%- if request.locale.iso_code == 'fr' -%}
    <script>
      (function () {
        try {
          if (/bot|crawler|spider|lighthouse|headless/i.test(navigator.userAgent)) return;
          var choix = localStorage.getItem('nk-lang');
          if (choix === 'fr') return;
          var nav = (navigator.language || '').slice(0, 2).toLowerCase();
          if (choix === 'en' || (nav && nav !== 'fr')) {
            if (!choix) localStorage.setItem('nk-lang', 'en');
            location.replace('/en' + location.pathname + location.search + location.hash);
          }
        } catch (e) {}
      })();
    </script>
    {%- endif -%}

    {%- if settings.meta_domain_verification != blank -%}
      <meta name="facebook-domain-verification" content="{{ settings.meta_domain_verification }}">
    {%- endif -%}

    <link rel="icon" type="image/png" sizes="32x32" href="{{ 'nakree-favicon-32.png' | asset_url }}">
    <link rel="icon" type="image/png" sizes="512x512" href="{{ 'nakree-favicon-512.png' | asset_url }}">
    <link rel="apple-touch-icon" href="{{ 'nakree-favicon-180.png' | asset_url }}">

    {%- comment -%}
      Referencement. Aucune promesse commerciale ici : ni « satisfait ou
      rembourse », ni garantie commerciale, ni gratuite de retour. Les protections sont dans
      les politiques, jamais en facade.
    {%- endcomment -%}
    <title>
      {%- if request.page_type == 'index' -%}
        {{ 'nk.meta.title_index' | t }}
      {%- elsif request.page_type == 'product' -%}
        {{ product.title }} | Nakree
      {%- elsif request.page_type == 'cart' -%}
        {{ 'nk.meta.title_panier' | t }} | Nakree
      {%- else -%}
        {{ page_title }} | Nakree
      {%- endif -%}
    </title>

    {%- assign desc_defaut = 'nk.meta.description' | t -%}
    <meta name="description" content="{% if page_description %}{{ page_description | escape }}{% else %}{{ desc_defaut }}{% endif %}">

    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Nakree">
    <meta property="og:locale" content="{{ 'nk.meta.og_locale' | t }}">
    <meta property="og:title" content="{{ page_title | default: 'Nakree' | escape }}">
    <meta property="og:description" content="{% if page_description %}{{ page_description | escape }}{% else %}{{ desc_defaut }}{% endif %}">
    <meta property="og:url" content="{{ canonical_url }}">
    {%- if request.page_type == 'product' and product.featured_image -%}
      <meta property="og:image" content="https:{{ product.featured_image | image_url: width: 1200 }}">
    {%- endif -%}
    <meta name="twitter:card" content="summary_large_image">

    {%- comment -%} Donnees structurees. La note et le nombre d'avis viennent
      du produit reel : on ne les ecrit pas en dur. {%- endcomment -%}
    {%- if request.page_type == 'product' -%}
      <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Product",
        "name": {{ product.title | json }},
        "description": {{ product.description | strip_html | truncate: 300 | json }},
        "image": ["https:{{ product.featured_image | image_url: width: 1200 }}"],
        "brand": { "@type": "Brand", "name": "Nakree" },
        "sku": {{ product.selected_or_first_available_variant.sku | json }},
        "offers": {
          "@type": "AggregateOffer",
          "priceCurrency": {{ cart.currency.iso_code | json }},
          "lowPrice": "{{ product.price_min | money_without_currency | strip }}",
          "highPrice": "{{ product.price_max | money_without_currency | strip }}",
          "offerCount": {{ product.variants.size }},
          "availability": "https://schema.org/{% if product.available %}InStock{% else %}OutOfStock{% endif %}",
          "url": "{{ shop.url }}{{ product.url }}"
        }
      }
      </script>
    {%- endif -%}

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Nakree",
      "url": "{{ shop.url }}",
      "email": "support@nakree.com"
    }
    </script>

    {%- comment -%} Polices : Geist, chargee sans bloquer le rendu {%- endcomment -%}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" media="print" onload="this.media='all'"
          href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap">
    <noscript><link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap"></noscript>

    {{ 'nakree-da.css' | asset_url | stylesheet_tag }}

    {%- comment -%}
      Pixel Meta : retire du theme le 19/08/2026. Le canal Facebook &
      Instagram (CAPI, partage Maximum) envoie desormais PageView,
      AddToCart, InitiateCheckout et Purchase, dedupliques entre
      navigateur et serveur. Un second fbq ici compterait tout en double.
    {%- endcomment -%}

    {{ content_for_header }}
  </head>

  <body class="template-{{ request.page_type }}">
    {% section 'nk-entete' %}

    <main id="contenu" role="main">
      {{ content_for_layout }}
    </main>

    {% section 'nk-pied' %}

    {% render 'nk-panier' %}

    {%- comment -%}
      Textes que le JavaScript ecrit lui-meme (prix, compte a rebours,
      libelles du tiroir). Poses ici depuis les fichiers de langue pour que
      nakree.js et nakree-panier.js parlent la langue de la page.
    {%- endcomment -%}
    <script>
      window.NK_I18N = {
        fmt: {{ 'nk.js.fmt' | t | json }},
        cure4: {{ 'nk.js.cure4' | t | json }},
        cure2: {{ 'nk.js.cure2' | t | json }},
        cure: {{ 'nk.js.cure' | t | json }},
        unFlacon: {{ 'nk.js.un_flacon' | t | json }},
        cure4mois: {{ 'nk.js.cure4mois' | t | json }},
        economisez: {{ 'nk.js.economisez' | t | json }},
        commander: {{ 'nk.js.commander' | t | json }},
        compte: {{ 'nk.js.compte' | t | json }},
        assurance: {{ 'nk.js.assurance' | t | json }},
        instant: {{ 'nk.js.instant' | t | json }},
        retirer: {{ 'nk.js.retirer' | t | json }},
        retirerUn: {{ 'nk.js.retirer_un' | t | json }},
        ajouterUn: {{ 'nk.js.ajouter_un' | t | json }}
      };
    </script>

    {{ 'nakree-panier.js' | asset_url | script_tag }}
    {{ 'nakree.js' | asset_url | script_tag }}
  </body>
</html>
