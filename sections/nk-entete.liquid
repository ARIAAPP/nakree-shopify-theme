<div class="nk-annonce" aria-hidden="true">
  <div class="nk-defil__int">
    <div class="nk-defil__gr">
      <span>Offre de lancement : jusqu'&#224; -40 %</span><span>Livraison offerte d&#232;s 50 &#8364;</span><span>4 flacons : 3 achet&#233;s + 1 offert</span><span>Formule cor&#233;enne</span>
    </div>
    <div class="nk-defil__gr">
      <span>Offre de lancement : jusqu'&#224; -40 %</span><span>Livraison offerte d&#232;s 50 &#8364;</span><span>4 flacons : 3 achet&#233;s + 1 offert</span><span>Formule cor&#233;enne</span>
    </div>
  </div>
</div>

<header class="nk-top">
  <div class="nk-top__in">
    <a class="nk-logo" href="{{ routes.root_url }}" aria-label="Nakree, retour &#224; l'accueil">nakree<i>.</i></a>

    <nav class="nk-nav">
      <a href="{{ routes.root_url }}#actifs">Les actifs</a>
      <a href="{{ routes.root_url }}#geste">Le rituel</a>
      <a href="{{ routes.root_url }}#avis">Avis</a>
      <a href="{{ routes.root_url }}#questions">Questions</a>
    </nav>

    <div class="nk-top__fin">
      <button type="button" class="nk-cartouche" data-panier-ouvrir aria-label="Voir mon panier"
              {% if cart.item_count == 0 %}hidden{% endif %} data-panier-nb-boite>
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/>
          <path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/>
        </svg>
        <span data-panier-nb>{{ cart.item_count }}</span>
      </button>

      <a class="nk-btn nk-btn--mini" href="{{ routes.root_url }}#offre">Commander <i>&#8599;</i></a>
    </div>
  </div>
</header>

<style>
  .nk-top__fin { display: flex; align-items: center; gap: 10px; }
  .nk-cartouche {
    display: inline-flex; align-items: center; gap: 7px;
    padding: 9px 14px; border: 0; border-radius: var(--nk-r-pill);
    background: var(--nk-surface); box-shadow: var(--nk-ring); cursor: pointer;
    font-size: 14px; font-weight: 600; color: var(--nk-ink);
  }
  .nk-cartouche:hover { box-shadow: var(--nk-ring-2), var(--nk-lift-1); }
  .nk-cartouche svg { color: var(--nk-accent-h); }
  @media (max-width: 560px) { .nk-cartouche span { display: none; } }
</style>

{% schema %}
{"name": "Entete Nakree", "settings": []}
{% endschema %}
