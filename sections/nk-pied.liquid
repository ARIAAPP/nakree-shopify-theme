<footer class="nk-foot">
  <div class="nk-wrap">
    <div class="lay-two" style="align-items:start;">

      <div class="stack-sm" style="max-width:38ch;">
        <span class="nk-logo">nakree<i>.</i></span>
        <p class="nk-foot__phrase">{{ 'nk.pied.phrase' | t }}</p>
        <p class="nk-note" style="margin-top:10px;">
          <a href="mailto:support@nakree.com">support@nakree.com</a>
        </p>
      </div>

      <div class="nk-foot__cols">
        <div>
          <h4>{{ 'nk.pied.boutique' | t }}</h4>
          <a href="{{ routes.root_url }}#offre">{{ 'nk.pied.cure' | t }}</a>
          <a href="{{ routes.root_url }}#actifs">{{ 'nk.nav.actifs' | t }}</a>
          <a href="{{ routes.root_url }}#geste">{{ 'nk.nav.rituel' | t }}</a>
          <a href="{{ routes.root_url }}pages/suivi">{{ 'nk.pied.suivi' | t }}</a>
        </div>
        <div>
          <h4>{{ 'nk.pied.infos' | t }}</h4>
          <a href="{{ routes.root_url }}#questions">{{ 'nk.nav.questions' | t }}</a>
          <a href="{{ routes.root_url }}pages/a-propos">{{ 'nk.pied.apropos' | t }}</a>
          <a href="{{ routes.root_url }}pages/cookies">{{ 'nk.pied.cookies' | t }}</a>
        </div>
        <div>
          <h4>{{ 'nk.pied.mentions' | t }}</h4>
          <a href="/policies/legal-notice">{{ 'nk.pied.legal' | t }}</a>
          <a href="/policies/terms-of-sale">{{ 'nk.pied.cgv' | t }}</a>
          <a href="/policies/refund-policy">{{ 'nk.pied.retours' | t }}</a>
          <a href="/policies/shipping-policy">{{ 'nk.pied.exped' | t }}</a>
          <a href="/policies/privacy-policy">{{ 'nk.pied.conf' | t }}</a>
          <a href="/policies/terms-of-service">{{ 'nk.pied.service' | t }}</a>
        </div>
      </div>

    </div>

    <div class="nk-foot__bas">
      <p class="nk-note">
        {{ 'nk.pied.disclaimer' | t }}
      </p>
    </div>
  </div>
</footer>

<style>
  .nk-foot__cols { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  @media (max-width: 620px) {
    .nk-foot__cols { grid-template-columns: repeat(2, 1fr); gap: 28px 20px; }
  }
</style>

{% schema %}
{"name": "Pied Nakree", "settings": []}
{% endschema %}
