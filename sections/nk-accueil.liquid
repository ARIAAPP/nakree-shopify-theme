          <div>
            <div class="nk-avm__qui">
              <span class="nk-avatar">{{ p[1] }}</span>
              <span>
                <span class="nk-avm__nom">{{ p[0] }}</span>
                <span class="nk-avm__date">{{ p[2] }} &#183; <b>{{ 'nk.avis.verifie_coche' | t }}</b></span>
              </span>
              <span class="nk-avm__etoiles" aria-label="{{ 'nk.avis.etoiles_aria' | t: n: s }}">{% for i in (1..5) %}<i{% if i > s %} class="off"{% endif %}>&#9733;</i>{% endfor %}</span>
            </div>
            <p class="nk-avm__txt">{{ p[4] }}</p>
          </div>
          {%- if p[5] != blank -%}
            {%- assign ph = p[5] | strip | append: '.jpg' -%}
            <button type="button" class="nk-avm__ph" data-pleine="{{ ph | file_url }}" aria-label="{{ 'nk.avis.ph_aria' | t: nom: p[0] }}">
              <img src="{{ ph | file_url }}" alt="{{ 'nk.avis.ph_alt' | t: nom: p[0] }}" loading="lazy">
            </button>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</dialog>

<dialog class="nk-avl" id="nk-avis-photo" aria-label="{{ 'nk.avis.photo_client' | t }}">
  <button type="button" class="nk-avl__x" aria-label="{{ 'nk.loupe.fermer' | t }}">&times;</button>
  <img src="" alt="">
</dialog>

<script>
  (function () {
    var d = document.getElementById('nk-avis-modal'), o = document.getElementById('nk-avis-open');
    if (!d || !o || typeof d.showModal !== 'function') return;
    o.addEventListener('click', function () { d.showModal(); d.querySelector('.nk-avm__liste').scrollTop = 0; });
    d.querySelector('.nk-avm__x').addEventListener('click', function () { d.close(); });
    d.addEventListener('click', function (e) { if (e.target === d) d.close(); });

    var l = document.getElementById('nk-avis-photo'), img = l.querySelector('img');
    d.querySelectorAll('.nk-avm__ph').forEach(function (b) {
      b.addEventListener('click', function () {
        img.src = b.getAttribute('data-pleine');
        img.alt = b.querySelector('img').alt;
        l.showModal();
      });
    });
    l.querySelector('.nk-avl__x').addEventListener('click', function () { l.close(); });
    l.addEventListener('click', function (e) { if (e.target === l) l.close(); });
    l.addEventListener('close', function () { img.src = ''; });
  })();
</script>

<!-- L'OFFRE -->
<section id="offre">
