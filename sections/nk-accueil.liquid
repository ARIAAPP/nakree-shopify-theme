    </div>
    <div class="nk-vids nk-rise" data-vids>
      {%- capture vids_src -%}01|{{ 'nk.videos.v1' | t }},02|{{ 'nk.videos.v2' | t }},03|{{ 'nk.videos.v3' | t }},04|{{ 'nk.videos.v4' | t }},05|{{ 'nk.videos.v5' | t }},06|{{ 'nk.videos.v6' | t }}{%- endcapture -%}
      {%- assign vids = vids_src | split: "," -%}
      {%- for item in vids -%}
        {%- assign parts = item | split: "|" -%}
        {%- assign mp4 = 'nakree-ugc-' | append: parts[0] | append: '.mp4' -%}
        <div class="nk-vid">
          <div class="nk-vid__ph"><b>{{ parts[1] }}</b></div>
          <video src="{{ mp4 | file_url }}" playsinline muted loop preload="metadata" aria-label="{{ parts[1] | escape }}"></video>
          <span class="nk-vid__tag">{{ parts[1] }}</span>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<script>
  /* Videos UGC : lecture automatique a l'apparition, pause hors ecran.
     Un fichier absent de Shopify Files declenche l'evenement error : la
     video se retire et la carte editoriale dessous reste en place. On ne
     retire JAMAIS sur un play() rejete (politique d'autoplay) ni sur un
     etat transitoire : networkState passe par NO_SOURCE juste apres la
     pose du src, meme pour un fichier valide. */
  (function () {
    var vids = document.querySelectorAll('[data-vids] video');
    if (!vids.length) return;
    vids.forEach(function (v) {
      v.addEventListener('error', function () { v.remove(); }, { once: true });
    });
    if (!('IntersectionObserver' in window)) return;
    var obs = new IntersectionObserver(function (ee) {
      ee.forEach(function (e) {
        var v = e.target;
        if (!v.isConnected) return;
        if (e.isIntersecting) { var p = v.play(); if (p) p.catch(function () {}); }
        else v.pause();
      });
    }, { threshold: .35 });
    vids.forEach(function (v) { obs.observe(v); });
  })();
</script>

