      <div class="nk-avm__note">
        <span class="nk-avm__big">4,9<small>/5</small></span>
        <span class="nk-etoiles">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
        <span class="nk-avm__total" id="nk-avm-titre">{{ 'nk.avis.modal_total' | t: n: nk_total, p: nk_nphotos }}</span>
      </div>
      <div class="nk-avm__barres">
        <div class="nk-avm__barre"><span>5 &#9733;</span><i><b style="width:{{ nk_pct5 }}%"></b></i><em>{{ nk_n5 }}</em></div>
        <div class="nk-avm__barre"><span>4 &#9733;</span><i><b style="width:{{ nk_pct4 }}%"></b></i><em>{{ nk_n4 }}</em></div>
        <div class="nk-avm__barre"><span>3 &#9733;</span><i><b style="width:0%"></b></i><em>0</em></div>
        <div class="nk-avm__barre"><span>2 &#9733;</span><i><b style="width:0%"></b></i><em>0</em></div>
        <div class="nk-avm__barre"><span>1 &#9733;</span><i><b style="width:0%"></b></i><em>0</em></div>
      </div>
      <button type="button" class="nk-avm__x" aria-label="{{ 'nk.loupe.fermer' | t }}">&times;</button>
    </div>
    <div class="nk-avm__liste">
      {%- for a in nk_avis -%}
        {%- assign p = a | strip | split: "|" -%}
        {%- assign s = p[3] | plus: 0 -%}
