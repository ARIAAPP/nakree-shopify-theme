            <span class="nk-case"></span>
            <span>{{ 'nk.hero.addon' | t }}</span>
            <span class="nk-addon__prix">{{ 'nk.hero.addon_prix' | t }}</span>
          </span>
        </label>

        <label class="nk-pack" data-pack data-nb="2" data-prix="4490" data-ref="4980" data-eco="490" data-variant="{{ v_deux.id }}">
          <input type="radio" name="pack">
          <span class="nk-pack__ligne">
            <span class="nk-radio"></span>
            <span class="nk-pack__nom">{{ 'nk.offre.p2_nom' | t }} <span class="nk-badge">{{ 'nk.offre.p2_badge' | t }}</span></span>
            <span class="nk-pack__prix">{{ 'nk.offre.p2_prix_html' | t }}</span>
          </span>
          <span class="nk-pack__desc">{{ 'nk.offre.p2_desc' | t }}</span>
        </label>

        <label class="nk-pack" data-pack data-nb="1" data-prix="2490" data-ref="0" data-eco="0" data-variant="{{ v_un.id }}">
          <input type="radio" name="pack">
          <span class="nk-pack__ligne">
            <span class="nk-radio"></span>
            <span class="nk-pack__nom">{{ 'nk.offre.p1_nom' | t }}</span>
            <span class="nk-pack__prix">{{ 'nk.offre.p1_prix' | t }}</span>
          </span>
          <span class="nk-pack__desc">{{ 'nk.offre.p1_desc' | t }}</span>
        </label>

        <button type="button" class="nk-btn" data-acheter><span data-cta>{{ 'nk.offre.cta' | t }}</span> <i>&#8599;</i></button>

        <ul class="nk-reassure">
          <li>{{ 'nk.offre.r1' | t }}</li>
          <li>{{ 'nk.offre.r2' | t }}</li>
          <li>{{ 'nk.offre.r3' | t }}</li>
          <li>{{ 'nk.offre.r4' | t }}</li>
        </ul>

        {% render 'nk-paiements', max: 7 %}
      </div>

      <div class="stack nk-rise" style="gap:18px;">
        <div class="nk-scene nk-scene--mini">
          {%- if serum.featured_image != blank -%}
            <div class="nk-slot rempli" style="position:absolute;inset:0;">
              <img src="{{ serum.featured_image | image_url: width: 800 }}" alt="{{ serum.title }}" loading="lazy">
            </div>
          {%- else -%}
            <span class="nk-scene__n" aria-hidden="true">n.</span>
            {% render 'nk-flacon', suffixe: 'o' %}
          {%- endif -%}
        </div>
        <div class="nk-garanties">
          <div><i>&#10003;</i>{{ 'nk.offre.g1' | t }}</div>
          <div><i>&#10003;</i>{{ 'nk.offre.g2' | t }}</div>
          <div><i>&#10003;</i>{{ 'nk.offre.g3' | t }}</div>
          <div><i>&#10003;</i>{{ 'nk.offre.g4' | t }}</div>
        </div>
      </div>
    </div>
  </div>
</section>


